{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marcasalao.com.br/schemas/guardrails.schema.json",
  "title": "TenantGuardrails",
  "description": "Contrato de conformidade editorial, separação de superfícies, elementos proibidos em UI e política de áudio por tenant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "forbiddenClaims",
    "forbiddenUiElements",
    "audioPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Versão do contrato de guardrails."
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "description": "Identificador do tenant dono desta política."
    },
    "forbiddenClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Lista de termos, regexes ou promessas vetadas em roteiros, legendas, SRT e narração."
    },
    "forbiddenUiElements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Lista de elementos/fluxos proibidos na interface demonstrada (ex.: pagamento, checkout, a pagar)."
    },
    "routeRules": {
      "type": "object",
      "description": "Mapa opcional de rotas para definição de superfície e responsabilidades permitidas/vetadas.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "allowedResponsibilities"],
        "properties": {
          "surface": { "type": "string", "minLength": 1 },
          "allowedResponsibilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "forbiddenResponsibilities": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "audioPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowAudioTrack", "requireExternalNarration", "requireSrt"],
      "properties": {
        "allowAudioTrack": { "type": "boolean" },
        "requireExternalNarration": { "type": "boolean" },
        "requireSrt": { "type": "boolean" },
        "ffmpegFlag": { "type": "string" }
      }
    }
  }
}
