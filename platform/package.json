{
  "name": "marcasalao-marketing-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Nucleo modular da Content Factory: manifesto de projeto, composicao declarativa v1, validacao e relatorio. Zero dependencias de runtime; TypeScript compilado para JavaScript antes da execucao, com Node >= 22.",
  "type": "module",
  "main": "./dist/src/composition-validation-api.js",
  "types": "./dist/src/composition-validation-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/composition-validation-api.d.ts",
      "import": "./dist/src/composition-validation-api.js"
    }
  },
  "files": [
    "dist/src",
    "!dist/src/*-cli.*"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=tap \"dist/tests/**/*.test.js\"",
    "test:contracts": "npm run build && node --test --test-reporter=tap \"dist/tests/contracts/*.test.js\"",
    "content:validate-project": "npm run build --silent && node dist/src/validate-project-cli.js",
    "content:validate-composition": "npm run build --silent && node dist/src/validate-composition-cli.js",
    "content:profiles": "npm run build --silent && node dist/src/output-profiles-cli.js",
    "content:plan-output": "npm run build --silent && node dist/src/output-plan-cli.js",
    "content:validate-beat-plan": "npm run build --silent && node dist/src/validate-beat-plan-cli.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  }
}
