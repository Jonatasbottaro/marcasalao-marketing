{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisualAnchor",
  "description": "Contrato declarativo VisualAnchor v1: referencia visual reutilizavel vinculada a uma versao de midia pelo ID da versao e pelo SHA-256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "reference",
    "direction",
    "mustInclude",
    "mustAvoid",
    "origin",
    "license"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "reference": {
      "$ref": "#/definitions/reference"
    },
    "direction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "mustInclude": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "mustAvoid": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  },
  "definitions": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaId",
        "versionId",
        "sha256"
      ],
      "properties": {
        "mediaId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "versionId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}