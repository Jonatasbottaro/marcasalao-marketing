{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ImageRequest",
  "description": "Contrato declarativo ImageRequest v1: pedido visual revisavel derivado do descritor de midia de uma cena ou card, com geometria do perfil e referencia visual opcional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "target",
    "profileId",
    "prompt",
    "purpose",
    "framing",
    "aspectRatio",
    "geometry",
    "anchor",
    "context"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "target": {
      "$ref": "#/definitions/target"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "framing": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "aspectRatio": {
      "type": "string",
      "enum": [
        "9:16",
        "1:1",
        "16:9",
        "4:5"
      ]
    },
    "geometry": {
      "$ref": "#/definitions/geometry"
    },
    "anchor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/anchorLink"
        }
      ]
    },
    "context": {
      "$ref": "#/definitions/context"
    }
  },
  "definitions": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "video_scene",
            "carousel_card"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        }
      }
    },
    "anchorLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorId",
        "versionId",
        "sha256",
        "sendToProvider"
      ],
      "properties": {
        "anchorId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "versionId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sendToProvider": {
          "type": "boolean"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor",
        "contextSha256"
      ],
      "properties": {
        "descriptor": {
          "type": "string",
          "maxLength": 2000
        },
        "contextSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}