{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MotionPlan",
  "description": "Contrato declarativo MotionPlan v1: contorno retangular animado vinculado a cenas do pedido de video.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "effects"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/effect"
      }
    }
  },
  "definitions": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneId",
        "region",
        "color",
        "thickness",
        "startMs",
        "endMs"
      ],
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "region": {
          "$ref": "#/definitions/region"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "thickness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "fadeInMs": {
          "type": "integer",
          "minimum": 0
        },
        "fadeOutMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}