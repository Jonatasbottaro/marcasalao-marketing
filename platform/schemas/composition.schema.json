{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Composition",
  "description": "Contrato declarativo de composicao da Content Factory (v1). Nao e roteiro, nao e BeatPlan e nao e renderizacao: o texto canonico permanece estruturado, assets sao referenciados (nunca gerados) e o renderizador pode permanecer undecided. A composicao e sempre validada contra um ProjectManifest informado explicitamente. Campos desconhecidos sao proibidos (additionalProperties=false). A implementacao de referencia das regras esta em platform/src/validate-composition.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "id",
    "title",
    "locale",
    "format",
    "scenes",
    "renderer"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Unica versao suportada nesta fatia."
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "id do ProjectManifest contra o qual a composicao e validada; deve ser igual a project.id."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificador da composicao em kebab-case."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Titulo tecnico da composicao; opaco para o nucleo."
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "description": "Idioma da composicao; na v1 deve ser igual a project.locale."
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "width", "height", "fps"],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Intencao de saida em kebab-case; deve existir em project.outputProfiles. Nao impoe resolucao automaticamente."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Largura em pixels, inteiro positivo."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Altura em pixels, inteiro positivo."
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "description": "Quadros por segundo, inteiro entre 1 e 120; nao limitado a 30."
        }
      }
    },
    "scenes": {
      "type": "array",
      "description": "Cenas declarativas da composicao, em ordem.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "durationMs", "content"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Identificador da cena em kebab-case, unico dentro da composicao."
          },
          "type": {
            "type": "string",
            "enum": ["text", "image", "video", "cta"],
            "description": "Tipo da cena na v1."
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1,
            "description": "Duracao da cena em milissegundos, inteiro maior que zero."
          },
          "content": {
            "description": "Conteudo da cena, em forma fechada por tipo.",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "minLength": 1 },
                  "accessibilityLabel": { "type": "string", "minLength": 1 }
                },
                "description": "Conteudo de cena text: texto canonico estruturado; asset e proibido."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "minLength": 1 },
                  "href": {
                    "type": "string",
                    "pattern": "^https?://",
                    "not": { "pattern": "^https?://[^/@]*:[^/@]*@" },
                    "description": "URL http(s) sem credenciais embutidas; nunca e acessada pelo validador."
                  },
                  "accessibilityLabel": { "type": "string", "minLength": 1 }
                },
                "description": "Conteudo de cena cta: chamada declarativa; asset e proibido."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["asset"],
                "properties": {
                  "asset": { "$ref": "#/definitions/assetReference" },
                  "alt": { "type": "string", "minLength": 1 },
                  "accessibilityLabel": { "type": "string", "minLength": 1 }
                },
                "description": "Conteudo de cena image: referencia de asset existente."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["asset"],
                "properties": {
                  "asset": { "$ref": "#/definitions/assetReference" },
                  "alt": { "type": "string", "minLength": 1 },
                  "accessibilityLabel": { "type": "string", "minLength": 1 }
                },
                "description": "Conteudo de cena video: referencia de asset existente."
              }
            ]
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Adaptador de renderizacao em kebab-case; \"undecided\" e aceito e nenhum adapter precisa estar instalado. options nao e suportado na v1."
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "review", "approved", "archived"],
          "description": "Status tecnico do artefato; \"approved\" aqui NAO concede autorizacao editorial, de gravacao ou de publicacao."
        },
        "description": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Tags informativas, sem duplicacao e sem uso como logica do core."
        }
      }
    }
  },
  "definitions": {
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Identificador do asset em kebab-case."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              { "pattern": "^/" },
              { "pattern": "^\\\\" },
              { "pattern": "^[A-Za-z]:[\\\\/]" },
              { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" },
              { "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:" }
            ]
          },
          "description": "Caminho relativo seguro: sem caminho absoluto, sem traversal, sem URL/protocolo e sem arquivos sensiveis (.env, chaves, credenciais). A existencia fisica NAO e verificada nesta fatia. AssetReference nao substitui o futuro AssetManifest."
        }
      }
    }
  }
}
