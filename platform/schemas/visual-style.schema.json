{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisualStyle",
  "description": "Contrato declarativo de VisualStyle v1: direcao visual compartilhada para sobreposicoes de titulos.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Unica versao suportada nesta fatia."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificador unico do estilo visual em kebab-case."
    },
    "title": {
      "$ref": "#/definitions/visualStyleTitle"
    }
  },
  "definitions": {
    "visualStyleTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textColor",
        "outlineColor",
        "fontSize",
        "marginTop",
        "marginHorizontal"
      ],
      "properties": {
        "textColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Cor hexadecimal do texto (#RRGGBB)."
        },
        "outlineColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Cor hexadecimal do contorno do texto (#RRGGBB)."
        },
        "fontSize": {
          "type": "integer",
          "minimum": 16,
          "maximum": 160,
          "description": "Tamanho da fonte em pixels no quadro de referencia (1080x1920)."
        },
        "marginTop": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600,
          "description": "Distancia vertical da margem superior em pixels no quadro de referencia."
        },
        "marginHorizontal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 400,
          "description": "Distancia das margens laterais esquerda e direita em pixels no quadro de referencia."
        }
      }
    }
  }
}
