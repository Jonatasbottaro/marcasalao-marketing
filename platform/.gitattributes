# Os scripts de shell do gate rodam tambem no windows-latest, onde o checkout padrao do
# runner converte texto em CRLF e o bash passa a falhar. LF neles e obrigatorio.
*.sh text eol=lf

# Exemplos de planos de saida comparados byte a byte contra o stdout da CLI:
# checkout no Windows nao pode converter para CRLF.
examples/output-plans/*.json text eol=lf

# Exemplos de BeatPlan: mesma razao dos planos de saida. Os testes leem os bytes
# do repositorio e o gate roda em windows-latest, onde o checkout padrao viraria CRLF.
examples/beat-plans/*.json text eol=lf

# Exemplos de pipeline: mesma razao dos planos de saida.
examples/pipelines/*.json text eol=lf

# Pacotes de execucao canonicos: comparados byte a byte entre gerador em
# memoria, serializacao, fixture versionada e CLI; o checkout Windows nao
# pode converter para CRLF.
examples/execution-packages/*.json text eol=lf

# Execucoes simuladas canonicas (plano, relatorio, eventos, hashes e
# artefatos textuais): mesma razao; comparacao byte a byte com a memoria e a CLI.
examples/simulated-executions/** text eol=lf

