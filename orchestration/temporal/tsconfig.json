{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "sourceMap": false,
        "declaration": false,
        "noEmitOnError": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "noUncheckedIndexedAccess": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts"]
}
