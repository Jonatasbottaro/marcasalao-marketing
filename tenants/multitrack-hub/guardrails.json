      "allowedResponsibilities": [
        "listagem-rateios-disponiveis",
        "status-vagas-rateio",
        "detalhes-faixas-inclusas"
      ],
      "forbiddenResponsibilities": [
        "cobranca-automatica-externa",
        "garantia-entrega-instantanea-sem-revisao"
      ]
    }
  },
  "audioPolicy": {
    "allowAudioTrack": true,
    "requireExternalNarration": false,
    "requireSrt": true
  }
}
