{
  "schemaVersion": 1,
  "tenantId": "multitrack-hub",
  "forbiddenClaims": [
    "whatsapp comercial",
    "telefone comercial",
    "faturamento garantido",
    "lucro garantido",
    "sem direitos autorais garantido",
    "gratuito ilimitado",
    "100% livre de licenciamento",
    "download automatico ilimitado"
