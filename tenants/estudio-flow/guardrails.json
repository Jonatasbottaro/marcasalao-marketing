      "allowedResponsibilities": [
        "identificacao-aluno-ficticia",
        "escolha-modalidade",
        "escolha-instrutor",
        "calculo-horarios-livres",
        "reserva-aula-experimental"
      ],
      "forbiddenResponsibilities": [
        "tela-pagamento",
        "cobranca-simulada",
        "promessa-cura-clinica",
        "envio-automatico-mensagem"
      ]
    },
    "/gestor/turmas": {
      "surface": "manager-agenda",
      "allowedResponsibilities": [
        "visualizacao-grade-turmas",
        "filtro-instrutor-status",
        "alteracao-manual-status"
      ],
      "forbiddenResponsibilities": [
        "calculo-horarios-livres",
        "exibicao-slots-disponiveis",
        "tela-pagamento",
        "namespace-e2e"
      ]
    }
  },
  "audioPolicy": {
    "allowAudioTrack": false,
    "requireExternalNarration": true,
    "requireSrt": true,
    "ffmpegFlag": "-an"
  }
}
